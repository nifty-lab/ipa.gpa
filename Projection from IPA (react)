label: d.period,
rejFit: rejModel.predict(i),
reworkFit: reworkModel.predict(i),
schedFit: schedModel.predict(i),
costFit: costModel.predict(i),
}));

const forecast = futureXs.map((x, fi) => {
const pRej = Math.min(0.70, rejModel.predict(x));
const pRew = Math.min(0.50, reworkModel.predict(x));
const pop  = Math.round(Math.min(1000, popModel.predict(x)));
const sched = Math.max(0, schedModel.predict(x));
const cost  = Math.max(1, costModel.predict(x));
const ciLow  = Math.max(0, pRej - z95 * se_rej);
const ciHigh = Math.min(1, pRej + z95 * se_rej);
return {
label: futureLabels[fi], isForecast: true,
rejRate: pRej, reworkRate: pRew, pop,
ciLow, ciHigh, schedSlip: sched, costOverrun: cost,
rejDocs: Math.round(pop * pRej),
reworkDocs: Math.round(pop * pRej * pRew),
reworkCost: Math.round(pop * pRej * pRew * 24 * 125),
};
});

return { historical, forecast, models: { rejModel, reworkModel, schedModel, costModel, popModel } };
}


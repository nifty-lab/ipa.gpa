const schedModel  = linReg(xs, historicalAudits.map(d=>d.schedSlip));
const costModel   = linReg(xs, historicalAudits.map(d=>d.costOverrun));
const popModel    = linReg(xs, historicalAudits.map(d=>d.pop));

// SE for CI
const se_rej    = 0.077;  // from our sample
const z95 = 1.96;

const futureLabels = [“Apr’26”, “Jul’26”, “Oct’26”, “Jan’27”, “Apr’27”, “Jul’27”];
const futureXs     = [8, 9, 10, 11, 12, 13];

const historical = historicalAudits.map((d, i) => ({
